/* Curated factory recipes. Inactive slots retain fmDefaultConfig values.
 * PAIR is modulator -> sine carrier; CHAIN adds a second modulator.
 * Modulator envelopes shape brightness; the patch envelope controls volume. */
typedef struct {
    const char *name;
    SynthEnvelopeConfig envelope;
    SynthEffectsConfig effects;
    int layerCount;
    SynthLayerConfig layers[3];
} FactoryRecipe;
#define OP(w, r, depth, a, d, s, z, hz, vib) \
    {.waveform=(w), .pulseWidth=.25, .ratio=(r), .rm=(depth), \
     .indexMode=FM_INDEX_ADSR, .decayRate=2, .attackMs=(a), .decayMs=(d), \
     .sustainPercent=(s), .releaseMs=(z), .vibratoRateHz=(hz), .vibratoDepthCents=(vib)}
#define TONE(w, r, g, dt, hz, vib) \
    {.gain=(g), .detuneCents=(dt), .fm={.operatorCount=1, \
     .operators={OP(w,r,0,0,0,100,0,hz,vib)}}}
#define PAIR(r, depth, cr, g, dt, a, d, s, z, hz, vib) \
    {.gain=(g), .detuneCents=(dt), .fm={.operatorCount=2, \
     .operators={OP(WAVE_SINE,r,depth,a,d,s,z,5,0), OP(WAVE_SINE,cr,0,0,0,100,0,hz,vib)}}}
#define CHAIN(r, depth, r2, depth2, cr, g, dt) \
    {.gain=(g), .detuneCents=(dt), .fm={.operatorCount=3, \
     .operators={OP(WAVE_SINE,r,depth,20,900,35,800,.7,12), \
     OP(WAVE_SINE,r2,depth2,80,1400,55,1000,1.1,6), OP(WAVE_SINE,cr,0,0,0,100,0,5,0)}}}
